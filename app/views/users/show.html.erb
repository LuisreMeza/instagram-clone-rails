<div class="row">
  <div class="col-md-8 col-md-offset-2">
    <!-- Perfil de Usuario -->
    <div class="profile-header">
      <div class="profile-avatar">
        <%= gravatar_for(@user, size: 150) %>
      </div>
      <div class="profile-info">
        <h2><%= @user.email.split('@').first %></h2>
        <p class="text-muted"><%= @user.email %></p>
        <div class="profile-stats">
          <span class="stat">
            <strong><%= @posts.count %></strong> publicaciones
          </span>
        </div>
      </div>
    </div>

    <!-- Grid de Publicaciones -->
    <h3 class="profile-section-title">Publicaciones</h3>
    <% if @posts.any? %>
      <div class="row">
        <% @posts.each do |post| %>
          <div class="col-md-4 col-sm-6">
            <div class="profile-post">
              <%= link_to post_path(post) do %>
                <%= image_tag post.image.url(:medium), class: "profile-post-image" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center" style="padding: 50px;">
        <p class="text-muted">Este usuario aún no ha publicado nada.</p>
      </div>
    <% end %>
  </div>
</div>